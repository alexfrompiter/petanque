<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Базовая тема — наследник Material3.DayNight. Compose-тема навешивается
         поверх в PetanqueTheme. Фон чёрный, чтобы избежать вспышек при
         переходах между экранами поверх видеопотока. -->
    <style name="Theme.Petanque" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
