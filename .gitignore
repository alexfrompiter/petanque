# ─── macOS ──────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── Xcode / Swift ──────────────────────────────────────────────
# Generated by XcodeGen — regenerated locally via `xcodegen generate`.
ios/*.xcodeproj/
ios/*.xcworkspace/

# Xcode user data
xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.xcscmblueprint
*.xccheckout

# Build artifacts
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
.build/
Packages/
Package.pins
Package.resolved

# CocoaPods (если когда-то добавим)
ios/Pods/
ios/Podfile.lock

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# ─── Android ────────────────────────────────────────────────────
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
android/.cxx/
*.iml
*.hprof

# ─── Python / ML ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.envrc
.ipynb_checkpoints/

# Веса моделей и датасет — большие, хранятся вне репо (LFS или releases)
ml/data/
ml/runs/
ml/models/*.mlpackage
ml/models/*.tflite
ml/models/*.pt
ml/models/*.onnx

# ─── Editors ────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── Logs / temp ────────────────────────────────────────────────
*.log
*.tmp
tmp/
